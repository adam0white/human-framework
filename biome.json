{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!archive",
      "!pnpm-lock.yaml",
      "!research",
      "!**/dist",
      "!**/.types",
      "!**/node_modules",
      "!.wrangler",
      "!.playwright-mcp",
      "!.claude",
      "!.worktrees",
      "!.lab-inbox",
      "!scratch",
      "!apps/site/src/lab/curated.json",
      "!apps/site/public/lab/island/runs",
      "!**/test/fixtures/*.json",
      "!docs/lab/experiments/**/raw.pass*.json"
    ]
  },
  "overrides": [
    {
      "includes": ["docs/lab/experiments/fixtures/hf-forecast/frozen-forecast.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["docs/lab/feedback-ledger.md"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
