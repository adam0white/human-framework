{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "human-framework",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  // Owner-authorized default-off free-text prototype; lifetime $1 reservation in R2.
  "ai": { "binding": "AI" },
  "preview_urls": false,
  "routes": [{ "pattern": "human.adamwhite.work", "custom_domain": true }],
  // The lab Worker (owner, 2026-10-19: server infrastructure for lab telemetry only). It runs only for the
  // paths in run_worker_first; everything else is static assets. Privacy: apps/site/lab/privacy/index.html.
  "main": "./apps/site/worker/lab.ts",
  "assets": {
    "directory": "./apps/site/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/lab/api/*", "/lab/data.json"]
  },
  // Private bucket: event batches, daily aggregates, opt-in runs and the private run index. No public access.
  "r2_buckets": [{ "binding": "LAB", "bucket_name": "hf-lab" }],
  // Per client address, in memory at the edge only (never stored). Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "EVENTS_LIMIT", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "RUNS_LIMIT", "namespace_id": "4102", "simple": { "limit": 3, "period": 60 } },
    // Shared keys mitigate ingress per location. A conditional R2 counter reserves daily run capacity.
    { "name": "EVENTS_ALL", "namespace_id": "4103", "simple": { "limit": 600, "period": 60 } },
    { "name": "RUNS_ALL", "namespace_id": "4104", "simple": { "limit": 12, "period": 60 } }
  ],
  // Every ten minutes: advance bounded aggregation/deletion and one private run-index page.
  "triggers": { "crons": ["*/10 * * * *"] },
  // No request logs: the lab must not keep addresses or headers.
  "observability": { "enabled": false }
}
