    "script_javascript": "import {runSimulation} from './src/core/index.js';\nimport {scenarios,getScenario} from './src/scenarios/index.js';\nfor (const s of scenarios) {\n const count={scenario:s.id,runs:0,helpExecutions:0,promisesKept:0,promisesExpired:0,anyTrustChanges:0,keptByActor:{},expiredByActor:{}};\n for(let seed=101;seed<=200;seed++) {\n  const r=runSimulation(getScenario(s.id),{seed,policy:'full'}); count.runs++;\n  count.helpExecutions+=r.history.flatMap(h=>h.decisions).filter(d=>d.actionKind==='help').length;\n  for(const a of r.actors) {\n   if(a.commitment?.fulfilled) {count.promisesKept++; count.keptByActor[a.id]=(count.keptByActor[a.id]??0)+1;}\n   if(a.commitment?.expired) {count.promisesExpired++; count.expiredByActor[a.id]=(count.expiredByActor[a.id]??0)+1;}\n   count.anyTrustChanges+=Object.values(a.relationships).filter(v=>v!==0.5).length;\n  }\n }\n console.log(JSON.stringify(count));\n}\n"
