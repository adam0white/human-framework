{
  "name": "@adam0white/lab-kit",
  "version": "0.5.17",
  "private": false,
  "description": "Small plain-DOM Field Notebook components for lab games",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json",
    "./stage.css": "./stage.css"
  },
  "bin": {
    "stamp-release": "./bin/stamp-release"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "tokens.css",
    "stage.css",
    "bin/stamp-release",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@adam0white/lab-client": "0.4.11 || 0.4.12 || 0.4.13 || 0.4.14 || 0.4.15"
  },
  "peerDependenciesMeta": {
    "@adam0white/lab-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam0white/human-framework.git",
    "directory": "packages/lab-kit"
  }
}
