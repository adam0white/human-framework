{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": ["node"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": ".types",
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",
    "rewriteRelativeImportExtensions": false,
    "paths": {
      "@adam0white/lab-client": ["../lab-client/src/index.ts"],
      "@adam0white/human-framework": ["../lab-client/node_modules/@adam0white/human-framework/dist/index.d.ts"]
    }
  },
  "include": ["src", "test", "../../scripts/lab-phone-helpers.ts"],
  "references": [
    {
      "path": "../lab-client"
    }
  ]
}
