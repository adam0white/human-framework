{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": ["node"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": ".types",
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",
    "rewriteRelativeImportExtensions": false
