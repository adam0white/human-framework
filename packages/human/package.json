{
  "name": "@adam0white/human-framework",
  "version": "2.1.3",
  "description": "Deterministic, explainable simulated people: body, needs, affect, memory, beliefs, skills, habits, relationships, values and a will that can refuse a suggestion",
  "keywords": [
    "simulation",
    "agents",
    "game-ai",
    "utility-ai",
    "deterministic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam0white/human-framework.git",
    "directory": "packages/human"
  },
  "homepage": "https://github.com/adam0white/human-framework/tree/main/packages/human#readme",
  "bugs": {
    "url": "https://github.com/adam0white/human-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "examples": "npm run build && node examples/minimal.ts && node examples/suggestions.ts && node examples/community.ts"
  }
}
