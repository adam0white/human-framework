{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "emitDeclarationOnly": true,
    "declarationDir": ".types",
    "paths": {
      "@adam0white/human-framework": ["../../packages/human/src/index.ts"],
      "@adam0white/lab-client": ["../../packages/lab-client/src/index.ts"],
      "@adam0white/lab-kit": ["../../packages/lab-kit/src/index.ts"]
    }
  },
  "include": ["src", "test", "worker", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/human"
    },
    {
      "path": "../../packages/lab-client"
    },
    {
      "path": "../../packages/lab-kit"
    }
  ]
}
