{
  "name": "human-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A deterministic, explainable framework for simulated people, with games that showcase it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam0white/human-framework.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "wt": "bash scripts/agent-worktree.sh",
    "test": "node scripts/suite-lock.ts -- vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts --maxWorkers=1 --silent=false",
    "bench:hyperfine": "hyperfine --warmup 1 --runs 10 'node scripts/bench-village.ts'",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w packages/human && npm run build -w packages/lab-client && npm run build -w packages/lab-kit && npm run build -w apps/site",
    "check:lane": "node scripts/lane.ts",
    "check:fast": "npm run check:lane --",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "node scripts/deploy.ts",
    "deploy:check": "node scripts/deploy.ts --dry-run",
    "release": "node scripts/release.ts",
    "api-doc": "npm run build -w packages/human && node scripts/api-doc.ts",
    "examples": "npm run examples -w packages/human",
    "lab:ledger": "node scripts/lab-ledger.ts",
    "lab:inbox": "node scripts/lab-inbox.ts",
    "lab:phone": "node scripts/lab-phone.ts",
    "lab:play": "node scripts/lab-play.ts",
    "lab:wai-usage": "node scripts/lab-wai-budget.ts",
    "lab:wai-play": "node scripts/lab-wai-play.ts --run",
    "lab:wai-install": "node scripts/install-wai-daily.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "vite": "8.3.4",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
