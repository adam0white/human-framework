{
  "name": "human-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A deterministic, explainable framework for simulated people, with games that showcase it",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts --maxWorkers=1 --silent=false",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w packages/human && npm run build -w apps/site",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "node scripts/deploy.ts",
    "deploy:check": "node scripts/deploy.ts --dry-run",
    "api-doc": "npm run build -w packages/human && node scripts/api-doc.ts",
    "examples": "npm run examples -w packages/human"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
